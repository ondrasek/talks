# GNU make on macOS: this folder is Windows-only; every target runs on the VM over SSH (see ../win.sh).
.PHONY: win-build win-run win-trace win-trace-py win-fetch
win-build:    ; ../win.sh build destinations-win32
win-run:      ; ../win.sh run destinations-win32
win-count:    ; ../win.sh count destinations-win32
win-trace:    ; ../win.sh trace destinations-win32
win-trace-py: ; ../win.sh trace-py destinations-win32
win-fetch:    ; ../win.sh fetch destinations-win32
